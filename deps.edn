;; Runtime dependencies only. project.clj (still kept for lein users) must list the same
;; ones plus clojure/clojurescript and the cljsjs/* jars; scripts/gate-im-tables.sh compares
;; the two (depcheck).
;;
;; Not declared here, on purpose:
;;  - org.clojure/clojure and clojurescript: the consuming application pins them (shadow-cljs
;;    bundles ClojureScript for our own builds).
;;  - cljsjs/*: React, react-select, react-day-picker and
;;    highlight.js come from npm (package.json). The sources still say (:require
;;    [cljsjs.react-select]) etc. and use the browser globals, so under shadow-cljs the shim/
;;    directory (the :cljs alias) supplies stand-in namespaces that load the npm package and
;;    set the same global. The shims are NOT in the jar: BlueGenes carries its own.
;;  - day8.re-frame/test: tests only, see the :test alias.
{:paths ["src"]

 ;; build.clj creates its basis from this file alone (:root nil, so the pom does not list
 ;; org.clojure/clojure), which means the Clojure CLI's built-in repositories are absent.
 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 :deps {org.clojure/core.async     {:mvn/version "1.1.587"}
        re-frame/re-frame          {:mvn/version "1.4.7"}
        reagent/reagent            {:mvn/version "1.2.0"}
        joshkh/ctrlz               {:mvn/version "0.3.0"}
        binaryage/oops             {:mvn/version "0.7.0"}
        inflections/inflections    {:mvn/version "0.13.2"}
        org.intermine/imcljs       {:mvn/version "1.6.0"}
        com.andrewmcveigh/cljs-time {:mvn/version "0.5.2"}}

 :aliases
 {;; Classpath for shadow-cljs (see shadow-cljs.edn :deps). Clojure 1.11 or later is needed
  ;; by shadow-cljs 2.28; the version here is only used for building/testing.
  ;; clojurescript is pinned to the version shadow-cljs 2.28.18 bundles: imcljs 1.6.0 still
  ;; declares 1.10.520, which would otherwise be picked.
  :cljs  {:extra-paths ["shim"]
          :extra-deps  {org.clojure/clojure       {:mvn/version "1.12.0"}
                        org.clojure/clojurescript {:mvn/version "1.11.132"}
                        thheller/shadow-cljs      {:mvn/version "2.28.18"}}}

  ;; browser dev tooling for the demo page (shadow-cljs preloads devtools by itself)
  :cljs-dev {:extra-deps {binaryage/devtools {:mvn/version "1.0.7"}}}

  :test  {:extra-paths ["test/cljs"]
          :extra-deps  {day8.re-frame/test {:mvn/version "0.1.5"}}}

  ;; clojure -M:fmt check | fix   (config: .cljfmt.edn)
  :fmt   {:deps      {dev.weavejester/cljfmt {:mvn/version "0.12.0"}}
          :main-opts ["-m" "cljfmt.main"]}

  ;; clojure -T:build clean | css | jar | install
  :build  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
           :ns-default build}

  ;; clojure -T:build:deploy deploy   (kept apart: deps-deploy drags in the AWS SDK)
  :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.2"}}}}}
